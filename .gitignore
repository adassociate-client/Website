node_modules/
.next/
out/
build/
.env
.env*.local
*.tsbuildinfo

# SQLite database files
prisma/*.db
prisma/*.db-journal

# Prisma 7 emits the client into the source tree; it is a build artifact
src/generated/
next-env.d.ts
.DS_Store

# Per-machine Claude Code settings — the shared .claude/settings.json is
# tracked, this one is personal.
.claude/settings.local.json

# Video masters dropped in the project root. Only the copy the site actually
# serves — public/assets/images/hero-video.mp4 — belongs in the repo; keeping
# the master beside it would commit the same footage twice, and git history is
# permanent. Store masters wherever the rest of the source media lives.
# To commit one anyway: git add -f "<filename>"
/*.mov
/*.mp4
# Source artwork dropped in the root. The processed copy the site serves lives
# under public/assets/images/; the original is not the deliverable.
/*.png
/*.jpg
