# ==========================================================================
# What must never reach a public repository.
# Grouped by why, because "why" is what stops someone deleting a line later.
# ==========================================================================

# --- Secrets --------------------------------------------------------------
# Every .env variant, not just the one that exists today. There is no
# committed template on purpose: the README documents the variables instead,
# so nothing here carries a real connection string, salt or contact detail.
.env
.env.*
*.env

# Credential material by shape, as a safety net for files nobody anticipated.
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*secret*.json
*credential*.json
service-account*.json
.npmrc
.netrc

# --- Build output and caches ---------------------------------------------
node_modules/
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts
# Prisma 7 emits its client into the source tree; it is a build artefact and
# `npm run build` regenerates it.
src/generated/

# --- Data -----------------------------------------------------------------
# The SQLite database holds submitted enquiries, including salted IP hashes.
prisma/*.db
prisma/*.db-journal
*.sqlite
*.sqlite3
*.dump
*.bak

# --- Test output ----------------------------------------------------------
# Traces, screenshots and failure videos are per-run debugging artefacts, and
# a video of a page that itself plays video is large.
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/coverage/

# --- Source media and internal working files ------------------------------
# Only the processed copies the site actually serves belong in git, and those
# live under public/assets/. These are the originals they were cut from:
# multi-megabyte masters, raw product photography, and internal documents
# that are not part of the website at all.
#
# To commit one deliberately: git add -f "<path>"
/Images/
/LOGO/
/Letterpad/
/*.mov
/*.mp4
/*.png
/*.jpg
/*.jpeg
/*.psd
/*.ai
/*.pptx
/*.docx
/*.xlsx
/*.pdf
/*.zip
# Internal notes and generation prompts — working material, not deliverables.
/cinematic_*.md

# --- Local tooling and OS ------------------------------------------------
# The shared .claude/settings.json is tracked; this one is per-machine.
.claude/settings.local.json
.vercel
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
