# Copy to .env and adjust. .env is gitignored; this file is not.

# --- Database -----------------------------------------------------------
# SQLite for local development. For Postgres, change the datasource provider
# in prisma/schema.prisma to "postgresql" and put the connection string here.
DATABASE_URL="file:./prisma/dev.db"

# --- Contact channels ---------------------------------------------------
# Seeded into the ContactChannel table by `npm run db:seed`.
# Phone numbers must be E.164 (leading +, digits only) — the WhatsApp deep
# link is built by stripping the +.
#
# NOTE: every value below is a placeholder. Replace them before going live.
CONTACT_PHONE_E164="+15550100200"
CONTACT_PHONE_DISPLAY="+1 (555) 010-0200"

# Optional second line. Leave both blank for a single number — the seed skips
# the channel entirely when the E.164 value is empty.
CONTACT_PHONE_ALT_E164=""
CONTACT_PHONE_ALT_DISPLAY=""

# WhatsApp lines. The site offers a choice when a second one is set; leave it
# blank to go straight to a chat with the first.
CONTACT_WHATSAPP_E164="+15550100200"
CONTACT_WHATSAPP_ALT_E164=""

# Instagram handle without the @.
CONTACT_INSTAGRAM_HANDLE="adassociates"
CONTACT_EMAIL="hello@adassociates.com"

# Prefilled WhatsApp message (URL-encoded automatically).
CONTACT_WHATSAPP_GREETING="Hello, I would like more information"

# Prefilled mailto: subject line (URL-encoded automatically). Leave blank for
# a bare mailto: with no subject.
CONTACT_EMAIL_SUBJECT="Enquiry for AD Associates"

# --- Security -----------------------------------------------------------
# Salt for hashing client IPs before storing them on enquiries.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT="change-me-in-production"

# Enquiry rate limit: max submissions per IP per window.
ENQUIRY_RATE_LIMIT="5"
ENQUIRY_RATE_WINDOW_MS="600000"
